{
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm build:chrome && pnpm build:firefox",
    "build:chrome": "pnpm --filter @tailchrome/extension build:chrome",
    "build:firefox": "pnpm --filter @tailchrome/extension build:firefox",
    "zip": "pnpm zip:chrome && pnpm zip:firefox",
    "zip:chrome": "pnpm --filter @tailchrome/extension zip:chrome",
    "zip:firefox": "pnpm --filter @tailchrome/extension zip:firefox",
    "lint:firefox": "pnpm --filter @tailchrome/extension lint:firefox",
    "review:firefox": "pnpm lint:firefox && pnpm zip:firefox && pnpm validate:firefox-publish",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "test:browser": "node ./scripts/e2e/run.mjs",
    "test:browser:chrome": "node ./scripts/e2e/run.mjs --browser=chrome",
    "test:browser:firefox": "node ./scripts/e2e/run.mjs --browser=firefox",
    "test:browser:full": "node ./scripts/e2e/run.mjs --suite=full --browser=chrome && node ./scripts/e2e/run.mjs --suite=full --browser=firefox",
    "test:browser:full:chrome": "node ./scripts/e2e/run.mjs --suite=full --browser=chrome",
    "test:browser:full:firefox": "node ./scripts/e2e/run.mjs --suite=full --browser=firefox",
    "e2e": "node ./scripts/e2e/windows-daytona.mjs",
    "e2e:windows": "node ./scripts/e2e/windows-daytona.mjs",
    "validate:ids": "node ./scripts/validate-extension-ids.mjs",
    "validate:firefox-publish": "node ./scripts/validate-firefox-publish.mjs",
    "validate:release-tag": "node ./scripts/validate-release-tag.mjs",
    "clean": "pnpm --filter @tailchrome/extension clean && rm -rf dist/"
  },
  "pnpm": {
    "overrides": {
      "picomatch": "^4.0.4",
      "vite": "^7.3.5",
      "postcss": "^8.5.23",
      "ws": "^8.20.1",
      "tmp": "^0.2.6",
      "fast-uri": "^3.1.5",
      "defu": "^6.1.5",
      "brace-expansion@1": "^1.1.18",
      "brace-expansion@5": "^5.0.9",
      "undici": "^7.29.0",
      "esbuild": "^0.28.1",
      "js-yaml": "^4.3.1",
      "nanoid@3": "^3.3.17",
      "shell-quote": "^1.8.4",
      "adm-zip": "^0.6.0",
      "node-notifier>uuid": "^11.1.1",
      "addons-linter>image-size": "-"
    },
    "packageExtensions": {
      "addons-linter@10.10.0": {
        "dependencies": {
          "probe-image-size": "^7.3.0"
        }
      }
    },
    "patchedDependencies": {
      "addons-linter@10.10.0": "patches/addons-linter@10.10.0.patch"
    }
  },
  "devDependencies": {
    "@daytona/sdk": "0.203.0",
    "puppeteer": "^25.3.0",
    "tar": "7.5.21"
  }
}
